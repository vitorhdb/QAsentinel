<UserControl x:Class="QASentinel.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Configuração operacional" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Timeout padrão (segundos)" Style="{StaticResource PropertyLabel}" Margin="0,20,0,6" />
            <TextBox Text="{Binding OperationTimeoutSeconds}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="Pasta de screenshots" Style="{StaticResource PropertyLabel}" Margin="0,16,0,6" />
            <TextBox Text="{Binding ScreenshotFolder}" IsReadOnly="True" />
            <TextBlock Text="Banco local" Style="{StaticResource PropertyLabel}" Margin="0,16,0,6" />
            <TextBox Text="{Binding DatabasePath}" IsReadOnly="True" />
            <TextBlock Text="Backend" Style="{StaticResource PropertyLabel}" Margin="0,16,0,6" />
            <TextBlock Text="{Binding AutomationBackend}" />
            <TextBlock Margin="0,20,0,0" Style="{StaticResource Caption}"
                       Text="Nesta sprint, as opções são exibidas como defaults locais. Edição persistida e retries entram após a validação do Inspector." />
        </StackPanel>
    </Border>
</UserControl>
