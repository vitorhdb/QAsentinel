<Window x:Class="QASentinel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QASentinel.Desktop.Views"
        xmlns:viewModels="clr-namespace:QASentinel.Desktop.ViewModels"
        Title="QA Sentinel" Height="860" Width="1460" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InspectorViewModel}"><views:InspectorView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TestsViewModel}"><views:TestsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ExecutionViewModel}"><views:ExecutionView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RecorderViewModel}"><views:RecorderView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ComingSoonViewModel}"><views:ComingSoonView /></DataTemplate>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D9E5F2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#173A5F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Navy950Brush}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,5,4,22">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="Q" FontWeight="Bold" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="QA Sentinel" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="DESKTOP AUTOMATION" Foreground="#7890A9" FontSize="9" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarButton}" Margin="0,1"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Foreground="#A9BED3" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#E7EEF6" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#6F8AA4" FontSize="9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource Navy900Brush}" CornerRadius="7" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="STATUS" Foreground="#6F8AA4" FontSize="9" />
                        <TextBlock Text="{Binding State.ConnectionStatus}" Foreground="White" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding State.ConnectionStatus}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="28,22,28,26" />
        </Grid>
    </Grid>
</Window>
