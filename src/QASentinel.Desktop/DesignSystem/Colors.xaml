<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Navy950">#081A31</Color>
    <Color x:Key="Navy900">#0C223D</Color>
    <Color x:Key="Blue600">#0F6FEB</Color>
    <Color x:Key="Blue500">#167AFF</Color>
    <Color x:Key="Blue100">#DCEBFF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Canvas">#F4F7FB</Color>
    <Color x:Key="Border">#DCE5EF</Color>
    <Color x:Key="TextPrimary">#10233D</Color>
    <Color x:Key="TextSecondary">#66788F</Color>
    <Color x:Key="Success">#16A36A</Color>
    <Color x:Key="Warning">#E7A019</Color>
    <Color x:Key="Error">#E34D59</Color>

    <SolidColorBrush x:Key="Navy950Brush" Color="{StaticResource Navy950}" />
    <SolidColorBrush x:Key="Navy900Brush" Color="{StaticResource Navy900}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Blue600}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Blue500}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource Blue100}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
</ResourceDictionary>
